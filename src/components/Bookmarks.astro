---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  const STORAGE_KEY = 'mona-bookmarks';
  const COUNTER_KEY = 'mona-bookmarks-counter';
  const BASE62 = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';

  interface Bookmark {
    url: string;
    slug: string;
  }

  function toBase62(num: number): string {
    if (num === 0) return '0';
    let n = num;
    let out = '';
    while (n > 0) {
      out = BASE62[n % 62] + out;
      n = Math.floor(n / 62);
    }
    return out;
  }

  function nextSlug(): string {
    const raw = localStorage.getItem(COUNTER_KEY);
    const current = raw ? Number.parseInt(raw, 10) : 1000;
    const next = Number.isFinite(current) && current >= 0 ? current + 1 : 1001;
    localStorage.setItem(COUNTER_KEY, String(next));
    return `mona-${toBase62(next)}`;
  }

  function normalizeUrl(input: string): string | null {
    const trimmed = input.trim();
    if (!trimmed) return null;
    const withScheme = /^https?:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
    try {
      const parsed = new URL(withScheme);
      return parsed.href;
    } catch {
      return null;
    }
  }

  function loadBookmarks(): Bookmark[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (item): item is Bookmark =>
          Boolean(item) &&
          typeof item.url === 'string' &&
          typeof item.slug === 'string'
      );
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks: Bookmark[]): void {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
  }

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const bookmarkList = document.getElementById('bookmark-list');
  const clearAllBtn = document.getElementById('clear-all');

  function renderBookmarks(): void {
    if (!bookmarkList || !emptyState || !listHeader) return;
    const bookmarks = loadBookmarks();
    bookmarkList.innerHTML = '';

    emptyState.toggleAttribute('hidden', bookmarks.length > 0);
    listHeader.toggleAttribute('hidden', bookmarks.length === 0);

    for (const { url, slug } of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = url;

      const badge = document.createElement('span');
      badge.className = 'slug';
      badge.textContent = slug;

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'copy';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(slug);
          copyBtn.textContent = 'Copied';
          setTimeout(() => {
            copyBtn.textContent = 'Copy';
          }, 1500);
        } catch {
          // Clipboard API may be unavailable in some contexts.
        }
      });

      li.append(link, badge, copyBtn);
      bookmarkList.appendChild(li);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!urlInput) return;

    const normalized = normalizeUrl(urlInput.value);
    if (!normalized) {
      urlInput.focus();
      return;
    }

    const bookmarks = loadBookmarks();
    bookmarks.unshift({ url: normalized, slug: nextSlug() });
    saveBookmarks(bookmarks);
    urlInput.value = '';
    renderBookmarks();
  });

  clearAllBtn?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    localStorage.removeItem(STORAGE_KEY);
    renderBookmarks();
  });

  renderBookmarks();
</script>
